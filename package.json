{
  "name": "kamiya-bot",
  "version": "6.0.0",
  "description": "",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rollup -c",
    "start": "node --es-module-specifier-resolution=node .",
    "lint": "prettier ./src/ --write --log-level warn && eslint \"src/**/*.ts\" --fix",
    "i18n": "i18next-resources-for-ts toc -i ./src/localization/zh-TW -o ./src/@types/resources.ts",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "keywords": [
    "discord.js"
  ],
  "author": {
    "name": "Kamiya",
    "email": "kamiya@kamiya.app",
    "url": "https://kamiya.app"
  },
  "license": "MIT",
  "dependencies": {
    "@exptechtw/api-wrapper": "github:ExpTechTW/api-wrapper",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "color-convert": "^2.0.1",
    "discord.js": "^14.16.3",
    "drizzle-orm": "^0.36.1",
    "i18next": "^23.15.1",
    "pretty-error": "^4.0.0",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@stylistic/eslint-plugin": "^2.10.1",
    "@types/bun": "^1.1.13",
    "@types/color-convert": "^2.0.4",
    "@types/tinycolor2": "^1.4.6",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.0",
    "eslint": "9.14.0",
    "i18next-resources-for-ts": "^1.5.0",
    "prettier": "^3.3.3",
    "rollup": "^4.24.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
